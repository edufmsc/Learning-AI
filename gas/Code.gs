function saveRecord_(p,d){const u=upsertUser_(p),s=db_().getSheetByName('LearningRecords'),old=rows_('LearningRecords').find(x=>x.user_id===u.user_id&&+x.day_no===+d.day_no),rid=old?.record_id||Utilities.getUuid(),row=[rid,u.user_id,d.day_no,scheduleDate_(u.start_date,+d.day_no),d.planned_minutes||90,d.actual_minutes||0,d.status||'in_progress',d.status==='completed'?now_():'',d.result_note||'',now_()];if(old)s.getRange(findCompositeRow_('LearningRecords',[['user_id',u.user_id],['day_no',d.day_no]]),1,1,row.length).setValues([row]);else s.appendRow(row);return{saved:true,status:d.status||'in_progress'}}
function savePortfolio_(p,d){if(!d.title)throw Error('請輸入作品名稱');const u=upsertUser_(p);db_().getSheetByName('Portfolio').appendRow([Utilities.getUuid(),u.user_id,d.day_no||'',d.title,d.tools||'',d.result||'',d.result_link||'',now_(),now_()]);return{saved:true}}
function generateReport_(p){const u=upsertUser_(p),plan=plan_(),rec=rows_('LearningRecords').filter(x=>x.user_id===u.user_id),done=new Set(rec.filter(x=>x.status==='completed').map(x=>+x.day_no)),mins=rec.reduce((a,x)=>a+(+x.actual_minutes||0),0),keys=['prompt','document','research','data','automation','visual','workflow'],tot=Object.fromEntries(keys.map(k=>[k,0])),got=Object.fromEntries(keys.map(k=>[k,0]));plan.forEach(x=>x.capability_tags.forEach(k=>{if(k in tot){tot[k]++;if(done.has(+x.day_no))got[k]++}}));const score=k=>tot[k]?Math.round(got[k]/tot[k]*100):0,scores=Object.fromEntries(keys.map(k=>[k+'_score',score(k)])),pairs=Object.entries(scores).sort((a,b)=>b[1]-a[1]),strengths=pairs.slice(0,2).map(x=>label_(x[0])).join('、'),gaps=pairs.slice(-2).map(x=>label_(x[0])).join('、'),next='優先加強「'+gaps+'」，並從作品集中挑選 1 個流程持續優化。',rate=Math.round(done.size/plan.length*100),row=[Utilities.getUuid(),u.user_id,now_(),rate,mins,scores.prompt_score,scores.document_score,scores.research_score,scores.data_score,scores.automation_score,scores.visual_score,scores.workflow_score,strengths,gaps,next];db_().getSheetByName('AI_Report').appendRow(row);return{completion_rate:rate,total_minutes:mins,...scores,strengths,skill_gaps:gaps,next_steps:next}}
function plan_(){return rows_('LearningPlan').filter(x=>String(x.active).toUpperCase()!=='FALSE').map(x=>({...x,day_no:+x.day_no,default_minutes:+x.default_minutes,points:parse_(x.points_json),checklist:parse_(x.checklist_json),capability_tags:parse_(x.capability_tags)})).sort((a,b)=>a.day_no-b.day_no)}
function scheduleDate_(start,day){let d=new Date((start||today_())+'T12:00:00'),n=1;while(n<day){d.setDate(d.getDate()+1);if(d.getDay()!==0&&d.getDay()!==6)n++}return Utilities.formatDate(d,CONFIG.TIMEZONE,'yyyy-MM-dd')}
function streak_(a){const dates=[...new Set(a.map(x=>x.checkin_date))].sort().reverse();if(!dates.length)return 0;let cur=new Date(today_()+'T12:00:00'),n=0;for(const ds of dates){while(cur.getDay()===0||cur.getDay()===6)cur.setDate(cur.getDate()-1);const c=Utilities.formatDate(cur,CONFIG.TIMEZONE,'yyyy-MM-dd');if(ds===c){n++;cur.setDate(cur.getDate()-1)}else if(ds<c)break}return n}
function label_(k){return({prompt_score:'Prompt',document_score:'文件處理',research_score:'搜尋研究',data_score:'資料分析',automation_score:'自動化',visual_score:'視覺表達',workflow_score:'工作流程整合'})[k]||k}function rows_(n){const s=db_().getSheetByName(n);if(!s||s.getLastRow()<2)return[];const v=s.getDataRange().getDisplayValues(),h=v[0];return v.slice(1).filter(r=>r.some(c=>c!=='')).map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])))}function findRow_(n,k,v){const i=rows_(n).findIndex(x=>String(x[k])===String(v));return i<0?-1:i+2}function findCompositeRow_(n,p){const i=rows_(n).findIndex(x=>p.every(([k,v])=>String(x[k])===String(v)));if(i<0)throw Error('找不到要更新的資料');return i+2}function parse_(s){try{return JSON.parse(s||'[]')}catch(e){return[]}}function db_(){return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID)}function today_(){return Utilities.formatDate(new Date(),CONFIG.TIMEZONE,'yyyy-MM-dd')}function now_(){return Utilities.formatDate(new Date(),CONFIG.TIMEZONE,'yyyy-MM-dd HH:mm:ss')}function out_(o,cb){const t=JSON.stringify(o);if(cb){if(!/^[A-Za-z_$][\w$]*$/.test(cb))throw Error('callback 不合法');return ContentService.createTextOutput(cb+'('+t+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}return ContentService.createTextOutput(t).setMimeType(ContentService.MimeType.JSON)}
