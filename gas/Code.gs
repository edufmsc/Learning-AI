function setupDatabase(){const ss=db_();Object.keys(HEADERS).forEach(n=>{let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);if(!s.getLastRow())s.getRange(1,1,1,HEADERS[n].length).setValues([HEADERS[n]]);s.setFrozenRows(1)});seedPlan_();const st=ss.getSheetByName('Settings');if(st.getLastRow()<2)st.getRange(2,1,3,3).setValues([['admin_email',CONFIG.ADMIN_EMAIL,'系統管理者'],['schedule_mode','weekday','週一至週五自動排程'],['version','2.0','AI Learning System']]);return 'OK'}
function seedPlan_(){const s=db_().getSheetByName('LearningPlan');if(s.getLastRow()>1)return;PLAN.forEach(p=>{const title=p[2],deliverable=p[5];const points=['了解 '+title+' 的核心方法','完成一個與工作相關的實作','檢查成果是否可重複使用'];const checks=['閱讀今日學習重點','完成至少一次實際操作','留下成果或學習紀錄','完成今日成果：'+deliverable];s.appendRow([p[0],p[1],title,p[3],p[4],deliverable,'以實際工作情境練習「'+title+'」，把學習轉成可重複使用的成果。',JSON.stringify(points),JSON.stringify(checks),'選擇一項目前工作上的真實任務，使用今日方法完成改善。','請依今日主題協助我拆解任務、提出步驟，並在輸出前檢查遺漏與風險。','完成並記錄：'+deliverable,JSON.stringify(p[6].split(',')),true])})}
function doGet(e){try{const q=e?.parameter||{},cb=q.callback||'',a=q.action||'health';if(a==='health')return out_({ok:true,data:{message:'AI Learning API OK',time:now_()}},cb);const profile=verify_(q.credential||''),payload=q.payload?JSON.parse(q.payload):{};let data;if(a==='bootstrap')data=bootstrap_(profile);else if(a==='checkin')data=checkin_(profile,payload);else if(a==='saveChecklist')data=saveChecklist_(profile,payload);else if(a==='saveRecord')data=saveRecord_(profile,payload);else if(a==='savePortfolio')data=savePortfolio_(profile,payload);else if(a==='generateReport')data=generateReport_(profile);else throw Error('未知 action：'+a);return out_({ok:true,data},cb)}catch(err){return out_({ok:false,error:err.message},e?.parameter?.callback||'')}}
function verify_(token){if(!token)throw Error('請先登入 Google 帳號');const r=UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token='+encodeURIComponent(token),{muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('Google 登入憑證無效或已過期');const p=JSON.parse(r.getContentText());if(String(p.email_verified)!=='true')throw Error('Google Email 尚未驗證');if(CONFIG.GOOGLE_CLIENT_ID&&p.aud!==CONFIG.GOOGLE_CLIENT_ID)throw Error('Google Client ID 不符');return{email:p.email,name:p.name||p.email,picture:p.picture||''}}
function bootstrap_(p){setupDatabase();const u=upsertUser_(p),plan=plan_(),records=rows_('LearningRecords').filter(x=>x.user_id===u.user_id),checks=rows_('Checklist').filter(x=>x.user_id===u.user_id),ins=rows_('Checkins').filter(x=>x.user_id===u.user_id),portfolio=rows_('Portfolio').filter(x=>x.user_id===u.user_id),done=records.filter(x=>x.status==='completed').map(x=>+x.day_no),currentNo=plan.find(x=>!done.includes(+x.day_no))?.day_no||20,withDates=plan.map(x=>({...x,schedule_date:scheduleDate_(u.start_date,+x.day_no)})),currentPlan=withDates.find(x=>+x.day_no===+currentNo),currentRecord=records.find(x=>+x.day_no===+currentNo)||null,currentChecklist=checks.filter(x=>+x.day_no===+currentNo).map(x=>({...x,checked:String(x.checked).toUpperCase()==='TRUE'})),todayCheckin=ins.find(x=>x.checkin_date===today_())||null,report=rows_('AI_Report').filter(x=>x.user_id===u.user_id).slice(-1)[0]||null;return{user:u,plan:withDates,records,currentPlan,currentRecord,currentChecklist,todayCheckin,portfolio,report,stats:{completedDays:done.length,streakDays:streak_(ins),totalMinutes:records.reduce((a,x)=>a+(+x.actual_minutes||0),0),portfolioCount:portfolio.length}}}
function upsertUser_(p){const s=db_().getSheetByName('Users'),all=rows_('Users');let u=all.find(x=>x.email.toLowerCase()===p.email.toLowerCase()),n=now_();if(!u){const id='U-'+Utilities.getUuid().slice(0,8);s.appendRow([id,p.email,p.name,p.picture,today_(),n,1,'active',n,n]);u=rows_('Users').find(x=>x.user_id===id)}else{const row=findRow_('Users','user_id',u.user_id);s.getRange(row,2,1,9).setValues([[p.email,p.name,p.picture,u.start_date||today_(),n,u.current_day||1,u.status||'active',u.created_at||n,n]]);u=rows_('Users').find(x=>x.user_id===u.user_id)}return u}
function checkin_(p,d){const u=upsertUser_(p),today=today_(),all=rows_('Checkins');if(all.some(x=>x.user_id===u.user_id&&x.checkin_date===today))return{message:'今天已打卡'};db_().getSheetByName('Checkins').appendRow([Utilities.getUuid(),u.user_id,today,Utilities.formatDate(new Date(),CONFIG.TIMEZONE,'HH:mm:ss'),d.day_no||1,now_()]);return{message:'打卡成功'}}
